{
  "name": "bobocloud-document-preview",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Official isolated office, data, image, notebook, archive, and PDF preview plugin for BOBOCloud.",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "release:check": "node scripts/check-release-tag.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/*.ui.mjs",
    "verify": "npm run package && npm run test && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "lucide": "1.33.0",
    "mammoth": "1.12.1",
    "marked": "18.0.10",
    "papaparse": "5.6.0",
    "pdfjs-dist": "6.2.108",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
