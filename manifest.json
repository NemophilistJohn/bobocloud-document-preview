{
  "schemaVersion": 2,
  "id": "bobocloud.document-preview",
  "displayName": "BOBOCloud Document Preview",
  "description": "Safely previews PDF, CSV, XLSX, and Markdown files inside isolated document views.",
  "version": "1.0.0",
  "engines": {
    "bobocloud": ">=2.6.1 <3.0.0",
    "pluginApi": "^1.3.0"
  },
  "main": "dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "permissions": [
    "documentViews.register",
    "documents.read"
  ],
  "contributes": {
    "documentViewers": [
      {
        "id": "bobocloud.document-preview.markdown",
        "extensions": [
          ".md",
          ".markdown"
        ],
        "entry": "dist/markdown-view.js",
        "resources": [
          "dist/view.css"
        ],
        "priority": 100
      },
      {
        "id": "bobocloud.document-preview.csv",
        "extensions": [
          ".csv",
          ".tsv"
        ],
        "entry": "dist/csv-view.js",
        "resources": [
          "dist/view.css"
        ],
        "priority": 100
      },
      {
        "id": "bobocloud.document-preview.excel",
        "extensions": [
          ".xlsx",
          ".xlsm",
          ".xltx"
        ],
        "entry": "dist/excel-view.js",
        "resources": [
          "dist/view.css"
        ],
        "priority": 100
      },
      {
        "id": "bobocloud.document-preview.pdf",
        "extensions": [
          ".pdf"
        ],
        "entry": "dist/pdf-view.js",
        "resources": [
          "dist/view.css",
          "dist/pdf.worker.min.mjs"
        ],
        "priority": 100
      }
    ]
  },
  "localization": {
    "default": "language-packs/en/messages.json",
    "en": "language-packs/en/messages.json",
    "zh-CN": "language-packs/zh-CN/messages.json",
    "ja": "language-packs/ja/messages.json"
  },
  "integrity": {
    "algorithm": "sha256",
    "files": {
      "dist/csv-view.js": "ee18fb5f54443ec20b468d1b5eef40c0d681629fbb018082e9306a485e45dc98",
      "dist/excel-view.js": "10934e6563157c3d9dbbb713ccfad210b84955abc52481485d5a5d48f7395680",
      "dist/extension.js": "d51c882ba6c85a8f688181e70365dfa0bdf6b51ca931ac6c5354062f92c608df",
      "dist/markdown-view.js": "d085dd36a146d09155a75e5df4f2fbc333dbc1bbc74506d8a1e52fcbed290303",
      "dist/pdf-view.js": "810e2ef7abb56c3a424672a597f23a04cc90c324832812f6deda63bf6e8848bc",
      "dist/pdf.worker.min.mjs": "bc0d1b88ea0b66196b1d36a58ac243c6d92adfe725624e2a9fdd381bdf8ef434",
      "dist/view.css": "13323e27f75d1a636564674efc2fed700b82f3ed2aa585546e814567427ac175",
      "language-packs/en/messages.json": "6c029caca57ef2f39d2be8c0c1e5e7e6f820410d37d10041f9d2077782649cab",
      "language-packs/ja/messages.json": "422a39b993e85771aaaa840a896298dc0c48632d33ec8ed063cadf9cb19e6a56",
      "language-packs/zh-CN/messages.json": "05fc9f905ed0e1e4f648dc2d2a43f961bd6e9071a6db67a2fce0f42f44ce37ca"
    }
  }
}
